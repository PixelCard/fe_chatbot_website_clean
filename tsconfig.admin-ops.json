{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "codex-next-env.d.ts",
    "app/services/apiClient.ts",
    "app/services/common/**/*.ts",
    "app/admin/_shared/**/*.ts",
    "app/admin/chats/services/**/*.ts",
    "app/admin/technicians/services/**/*.ts",
    "app/admin/technicians/types/**/*.ts",
    "app/admin/quotes/**/*.ts",
    "app/admin/quotes/**/*.tsx",
    "app/admin/repair-sessions/**/*.ts",
    "app/admin/repair-sessions/**/*.tsx",
    "app/admin/dispatch/**/*.ts",
    "app/admin/dispatch/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
