{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "codex-next-env.d.ts",
    "app/services/apiClient.ts",
    "app/services/common/**/*.ts",
    "app/hooks/common/**/*.ts",
    "app/auth/services/auth.service.ts",
    "app/auth/hooks/useAuthApi.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
